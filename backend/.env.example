# --- Zorunlu ---
GEMINI_API_KEY=your_gemini_api_key_here

# --- Istege bagli ---
# Rakip/pazar aramasi (google.serper.dev). Bos ise benchmark adimi atlanir.
SERPER_API_KEY=your_serper_api_key_here
# Sabit Gemini modeli (ornek: gemini-2.5-flash). Bos ise en uygun model otomatik secilir.
GEMINI_MODEL=

# Virgulle ayrilmis izinli frontend origin'leri. "*" kabul edilmez.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Header the hosting proxy writes with the real client address (Render: CF-Connecting-IP). Empty = socket peer.
# Only for a header the proxy overwrites; see docs/deployment.md §6.2.
CLIENT_IP_HEADER=
# production oldugunda /docs ve /openapi.json kapanir.
ENV=development
LOG_LEVEL=INFO
# text (varsayilan) veya json: her satir tek JSON nesnesi, requestId alanli.
LOG_FORMAT=text

# IP basina dakikalik istek limitleri (0 = kapali).
RATE_LIMIT_SIMULATE_PER_MIN=5
RATE_LIMIT_ANALYZE_PER_MIN=10
RATE_LIMIT_LINK_PER_MIN=10
# Istek govdesi siniri (byte). Varsayilan 10 MB.
MAX_BODY_BYTES=10485760

# Simulasyon gecmisi (paylasim linkleri). false = kaydetme.
HISTORY_ENABLED=true
HISTORY_RETENTION_DAYS=90
HISTORY_MAX_ROWS=5000
RATE_LIMIT_HISTORY_PER_MIN=60
RATE_LIMIT_WHATIF_PER_MIN=20
# Live score on the product form (no AI); called ~once per typing pause.
RATE_LIMIT_DRAFT_PER_MIN=60
RATE_LIMIT_CHAT_PER_MIN=15

# AI butcesi (Faz 10a). Ayni istem + veri icin AI cevabi bu sure boyunca onbellekten verilir (0 = kapali).
AI_CACHE_TTL_SECONDS=21600
AI_CACHE_MAX_ENTRIES=500
# IP basina gunluk gercek AI cagrisi (Turkiye saatine gore gun). Bir simulasyon 2-3 cagri harcar;
# onbellekten gelen cevap harcamaz. Dolunca AI kismi kural tabanliya duser (0 = sinirsiz).
AI_DAILY_CALLS_PER_IP=60

# MCP connector (Faz 11, docs/mcp-connector.md). /mcp adresinde; sunucu tarafinda AI cagirmaz.
# Disaridan erisilecekse alan adini yaz (bos = yalnizca localhost).
MCP_ALLOWED_HOSTS=
# Doluysa her istek ?key=<deger> ister.
MCP_ACCESS_KEY=
# Tum MCP cagrilari icin tek dakikalik limit (Claude, Anthropic sunucularindan baglanir).
MCP_RATE_LIMIT_PER_MIN=60
# Doluysa simulate_product sitede acilacak linki doner.
PUBLIC_SITE_URL=
