# --- Zorunlu ---
GEMINI_API_KEY=your_gemini_api_key_here

# --- Istege bagli ---
# Rakip/pazar aramasi (google.serper.dev). Bos ise benchmark adimi atlanir.
SERPER_API_KEY=your_serper_api_key_here
# Sabit Gemini modeli (ornek: gemini-2.5-flash). Bos ise en uygun model otomatik secilir.
GEMINI_MODEL=

# Virgulle ayrilmis izinli frontend origin'leri. "*" kabul edilmez.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# production oldugunda /docs ve /openapi.json kapanir.
ENV=development
LOG_LEVEL=INFO

# IP basina dakikalik istek limitleri (0 = kapali).
RATE_LIMIT_SIMULATE_PER_MIN=5
RATE_LIMIT_ANALYZE_PER_MIN=10
RATE_LIMIT_LINK_PER_MIN=10
# Istek govdesi siniri (byte). Varsayilan 10 MB.
MAX_BODY_BYTES=10485760

# Simulasyon gecmisi (paylasim linkleri). false = kaydetme.
HISTORY_ENABLED=true
HISTORY_RETENTION_DAYS=90
HISTORY_MAX_ROWS=5000
RATE_LIMIT_HISTORY_PER_MIN=60
